[Unit]
Description=Dedicated social-tunnel OpenSSH authorization and forward
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/st-domains-supervisor serve-sshd
RuntimeDirectory=social-tunnel-domains/sshd
RuntimeDirectoryMode=0700
RestrictNamespaces=yes
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_PTRACE
NoNewPrivileges=yes
KillMode=control-group
TimeoutStopSec=8
Restart=no

[Install]
WantedBy=multi-user.target
