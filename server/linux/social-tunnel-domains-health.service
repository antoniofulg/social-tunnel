[Unit]
Description=Check Social Tunnel through the protected loopback proxy

[Service]
Type=oneshot
EnvironmentFile=/etc/social-tunnel-domains/health.conf
LoadCredential=social-tunnel-heartbeat.url
ExecStart=/usr/local/sbin/st-domains-health
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=25
