{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local Settings only: core events and fixed app commands.",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-run-check",
    "allow-copy-fix",
    "allow-set-open-at-login",
    "allow-get-domains",
    "allow-edit-domain",
    "allow-retry-domain-edit"
  ]
}
