{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Settings window: core events and the app's four commands, nothing else.",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-run-check",
    "allow-copy-fix",
    "allow-set-open-at-login"
  ]
}
