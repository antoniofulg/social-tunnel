{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "social-tunnel",
  "version": "0.0.0",
  "identifier": "tech.antoniofulg.social-tunnel.tray",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "social-tunnel",
        "url": "index.html",
        "width": 640,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" },
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/social-tunnel"],
    "icon": ["icons/icon.png"]
  }
}
